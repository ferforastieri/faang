{
  // Worker que serve o site inteiro (landing, catálogo, docs, chat e dashboard).
  // `.open-next/` é produzido por `opennextjs-cloudflare build`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faang",
  "main": ".open-next/worker.js",
  // Publicado só no domínio próprio; nenhum <worker>.workers.dev.
  "workers_dev": false,
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Assets estáticos (CSS, JS, imagens) saem direto da borda; o Worker só
  // acorda para o que precisa renderizar.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
